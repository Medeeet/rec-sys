{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mlflow-ui",
      "runtimeExecutable": ".venv/bin/mlflow",
      "runtimeArgs": ["ui", "--backend-store-uri", "outputs/mlruns", "--host", "0.0.0.0", "--port", "5000"],
      "port": 5000
    },
    {
      "name": "train",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["scripts/train.py", "--experiment", "hybrid_main"],
      "port": 5001
    },
    {
      "name": "optuna-dashboard",
      "runtimeExecutable": ".venv/bin/optuna-dashboard",
      "runtimeArgs": ["sqlite:///outputs/optuna/study.db", "--host", "0.0.0.0", "--port", "5002"],
      "port": 5002
    }
  ]
}
